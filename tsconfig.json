{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["jest", "@testing-library/jest-dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts", 
    "**/*.ts", "**/*.tsx", 
    ".next/types/**/*.ts",   
    "src/config/index.js",
    "src/config/production.jhs",
    "src/config/staging.js",
    "src/config/development.js",
    "src/config/base.js",
    "src/config/base.js"
, "jest.config.js", "src/config/production.js"  ],
  "exclude": ["node_modules"]
}
